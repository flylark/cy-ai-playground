# Which provider run_eval.py uses for generation + judging: "claude" or "gemini".
# Embeddings always use Gemini regardless of this setting (see providers.py).
LLM_PROVIDER=claude

# Required only if LLM_PROVIDER=claude
ANTHROPIC_API_KEY=your-api-key-here
# Optional override -- check https://docs.claude.com/en/docs/about-claude/models
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Always required (embeddings), and required if LLM_PROVIDER=gemini
GOOGLE_API_KEY=your-api-key-here
# Optional override
# GEMINI_MODEL=gemini-3.6-flash
